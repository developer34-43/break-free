# ============================================
# BREAK FREE - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# ============================================

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/breakfree
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breakfree
MONGODB_URI=mongodb://127.0.0.1:27017/breakfree

# Port on which the server runs
PORT=5000

# Admin login credentials (used only if no admin exists in the database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123

# Secret used to sign admin session tokens
SESSION_SECRET=change-this-to-a-long-random-string